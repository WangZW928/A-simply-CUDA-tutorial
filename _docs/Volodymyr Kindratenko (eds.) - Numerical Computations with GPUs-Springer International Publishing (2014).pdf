         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">N-body simulations are applied to a variety of scientific problems, from space simulations to modeling molecular interactions</rdf:li>
            </rdf:Alt>
         </dc:title>
